<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Reliquary</AssemblyName>
    <RootNamespace>Reliquary</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NuGetAudit>false</NuGetAudit>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <RuntimeIdentifier></RuntimeIdentifier>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RestoreAdditionalProjectSources></RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MelonLoaderNet6)/MelonLoader.dll" Private="false" />
    <Reference Include="$(MelonLoaderNet6)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonLoaderNet6)/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/UnityEngine.MiHoYoExtensionModule.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(Il2CppAssemblies)/Assembly-CSharp.dll" Private="false" />
  </ItemGroup>
</Project>
